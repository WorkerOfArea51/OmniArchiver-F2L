# ================= TELEGRAM CONFIG =================
# API credentials from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Primary Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=YourBotUsername

# Multi-Client Worker Tokens (optional, space or comma separated for maximum streaming speed)
# Example: MULTI_BOT_TOKENS="token1 token2 token3"
MULTI_BOT_TOKENS=""

# Owner & Authorized Admins (space-separated Telegram user IDs)
OWNER_ID=1234567890
AUTH_USERS=""

# Allowed Users for general usage (leave empty to allow everyone)
ALLOWED_USER_IDS=""

# Optional: Fallback Storage / Dump Channel ID (with -100 prefix)
# ONLY needed if uploading files directly via private DM to the bot.
# If you only index existing channels using /link or /batch, leave this empty!
TELEGRAM_CHANNEL_ID=""
SECRET_CODE_LENGTH=24

# ================= DATABASE CONFIG =================
# MongoDB Atlas Connection URL (e.g. mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority)
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=OmniArchiver

# ================= WEB SERVER CONFIG ===============
# Public base URL of your VPS or domain (e.g. https://yourdomain.com or http://YOUR_VPS_IP:8080)
BASE_URL=https://yourdomain.com
BIND_ADDRESS=0.0.0.0
PORT=8080
