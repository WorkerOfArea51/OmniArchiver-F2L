# ================================================================
#  OmniArchiver F2L - Production Environment Variables
# ================================================================

# --- Core Telegram API Credentials ---
# Obtain from https://my.telegram.org
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Primary Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Multi-Client Worker Tokens (Optional)
# Comma-separated list of auxiliary bot tokens to distribute MTProto download streams
# Example: 12345:TokenA,67890:TokenB,11223:TokenC
MULTI_TOKENS=

# Private Storage Channel ID (must start with -100)
# Ensure your bot is an ADMIN with full permissions in this channel!
BIN_CHANNEL_ID=-1001234567890

# --- Server & Network Settings ---
# Hostname or domain for public URLs (e.g., streamhub69.alwaysdata.net or your-vps.com)
# DO NOT include http:// or https://
BASE_URL=streamhub69.alwaysdata.net
BIND_ADDRESS=0.0.0.0
PORT=8080
HAS_SSL=True

# --- Admin & Permissions ---
# Numeric Telegram User ID of the bot owner
OWNER_ID=123456789
# Comma-separated list of authorized user IDs (leave empty for public mode)
AUTH_USERS=

# --- Database (Optional) ---
# Leave empty to use embedded high-speed SQLite (omni_archiver.db)
# Or provide a MongoDB URI: mongodb+srv://user:pass@cluster.mongodb.net/dbname
DATABASE_URL=

# --- Performance & Caching ---
# Chunk size in bytes (524288 = 512 KB, 1048576 = 1 MB)
CHUNK_SIZE=524288
# Max in-memory LRU header cache in MB (keeps initial 5MB & last 2MB for instant seek/play)
CACHE_SIZE_MB=32
# Sleep threshold in seconds for Telegram FloodWait
SLEEP_THRESHOLD=60
# Number of Pyrogram client worker threads
WORKERS=6
