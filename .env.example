# ================================================================
#  OmniArchiver F2L - Production Environment Variables
# ================================================================

# --- Core Telegram API Credentials ---
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Auxiliary multi-token worker pool (Optional)
# Comma-separated list of auxiliary bot tokens to distribute MTProto download streams
MULTI_TOKENS=

# Your Channels (Anime, Movie, Web Series)
# Comma-separated list of channel IDs (must start with -100)
# Make sure your bot is an ADMIN in all configured channels!
CHANNELS=-1001234567890,-1009876543210,-1005544332211

# --- Server & Network Settings ---
# Your VPS Domain or IP (e.g. your-domain.com or 123.45.67.89:8080)
BASE_URL=your-domain.com
BIND_ADDRESS=0.0.0.0
PORT=8080
HAS_SSL=True

# --- Admin & Permissions ---
OWNER_ID=123456789
AUTH_USERS=

# --- Database (Optional MongoDB URI, defaults to local SQLite) ---
DATABASE_URL=

# --- Performance & Caching ---
CHUNK_SIZE=524288
CACHE_SIZE_MB=32
SLEEP_THRESHOLD=60
WORKERS=6
